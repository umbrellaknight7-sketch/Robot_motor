  </link>
  <!-- Left_Arm_Link5 -> Left_Wrist_Joint -> Left_Hand_Link -->
  <joint name="Left_Wrist_Joint" type="revolute">
    <!-- Synthetic wrist axis/limits for software tests; must be calibrated. -->
    <axis xyz="0 1 0"/>
    <limit lower="-1.0" upper="1.0" velocity="1.0" effort="1.0"/>
    <parent link="Left_Arm_Link5" />
    <child link="Left_Hand_Link" />
    <origin xyz="0 -0.12 -0.08" rpy="0 0 0" />
  </joint>
  <!-- Rigid hand placeholder; no finger articulation in the supplied topology. -->
  <link name="Left_Hand_Link">
    <inertial>
      <origin xyz="0 0 -0.06" rpy="0 0 0" />
      <mass value="0.25" />
      <inertia ixx="0.000433333333333" ixy="0" ixz="0" iyy="0.000333333333333" iyz="0" izz="0.000166666666667" />
