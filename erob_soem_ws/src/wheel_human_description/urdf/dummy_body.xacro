  </link>
  <!-- Left_Arm_Link4 -> Left_Arm_Joint4 -> Left_Arm_Link5 -->
  <joint name="Left_Arm_Joint4" type="revolute">
    <parent link="Left_Arm_Link4" />
    <child link="Left_Arm_Link5" />
    <origin xyz="0 0 -0.18" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-1.57079632679" upper="1.57079632679" effort="20" velocity="1" />
  </joint>
  <!-- Short inward/downward end segment. Rotated box COM frame; principal inertia about its COM. -->
  <link name="Left_Arm_Link5">
    <inertial>
      <origin xyz="0 -0.06 -0.04" rpy="2.15879893034 0 0" />
      <mass value="0.3" />
      <inertia ixx="0.000570625" ixy="0" ixz="0" iyy="0.000570625" iyz="0" izz="0.00010125" />
    </inertial>
    <visual>
