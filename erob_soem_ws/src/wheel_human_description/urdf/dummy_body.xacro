  <!-- Right_Arm_Link1 -> Right_Arm_Joint1 -> Right_Arm_Link2 -->
  <joint name="Right_Arm_Joint1" type="revolute">
    <parent link="Right_Arm_Link1" />
    <child link="Right_Arm_Link2" />
    <origin xyz="0 -0.22 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-1.57079632679" upper="1.57079632679" effort="20" velocity="1" />
