  </link>
  <!-- Right_Arm_Link4 -> Right_Arm_Joint4 -> Right_Arm_Link5 -->
  <joint name="Right_Arm_Joint4" type="revolute">
    <parent link="Right_Arm_Link4" />
    <child link="Right_Arm_Link5" />
    <origin xyz="0 0 -0.18" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-1.57079632679" upper="1.57079632679" effort="20" velocity="1" />
  </joint>
  <!-- Short inward/downward end segment. Rotated box COM frame; principal inertia about its COM. -->
  <link name="Right_Arm_Link5">
    <inertial>
      <origin xyz="0 0.06 -0.04" rpy="-2.15879893034 0 0" />
      <mass value="0.3" />
      <inertia ixx="0.000570625" ixy="0" ixz="0" iyy="0.000570625" iyz="0" izz="0.00010125" />
    </inertial>
    <visual>
      <origin xyz="0 0.06 -0.04" rpy="-2.15879893034 0 0" />
      <geometry>
        <box size="0.045 0.045 0.144222051019" />
      </geometry>
      <material name="right_arm_orange" />
    </visual>
    <collision>
      <origin xyz="0 0.06 -0.04" rpy="-2.15879893034 0 0" />
      <geometry>
        <box size="0.045 0.045 0.144222051019" />
      </geometry>
    </collision>
  </link>
  <!-- Right_Arm_Link5 -> Right_Wrist_Joint -> Right_Hand_Link -->
  <joint name="Right_Wrist_Joint" type="revolute">
    <!-- Synthetic wrist axis/limits for software tests; must be calibrated. -->
    <axis xyz="0 1 0"/>
    <limit lower="-1.0" upper="1.0" velocity="1.0" effort="1.0"/>
    <parent link="Right_Arm_Link5" />
    <child link="Right_Hand_Link" />
    <origin xyz="0 0.12 -0.08" rpy="0 0 0" />
  </joint>
  <!-- Rigid hand placeholder; no finger articulation in the supplied topology. -->
  <link name="Right_Hand_Link">
    <inertial>
      <origin xyz="0 0 -0.06" rpy="0 0 0" />
      <mass value="0.25" />
      <inertia ixx="0.000433333333333" ixy="0" ixz="0" iyy="0.000333333333333" iyz="0" izz="0.000166666666667" />
    </inertial>
    <visual>
      <origin xyz="0 0 -0.06" rpy="0 0 0" />
      <geometry>
        <box size="0.04 0.08 0.12" />
      </geometry>
      <material name="hand_dark" />
    </visual>
    <collision>
      <origin xyz="0 0 -0.06" rpy="0 0 0" />
      <geometry>
        <box size="0.04 0.08 0.12" />
      </geometry>
    </collision>
  </link>
  </xacro:macro>
</robot>
