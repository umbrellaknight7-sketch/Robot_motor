<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Legacy wrists_enabled argument is accepted for include compatibility;
       both wrist joints are always revolute in this description. -->
  <xacro:macro name="wheel_human_dummy_body" params="wrists_enabled:=true">
  <!--
  SOFTWARE-ONLY PLACEHOLDER MODEL - NOT FOR REAL MOTOR CONTROL.

  Topology and case-sensitive names follow the user's robot structure drawing.
  The unlabelled left-arm joint between Left_Arm_Link3 and Left_Arm_Link4
  is inferred to be Left_Arm_Joint3, matching the right arm.

  Root: base_link. 20 links, 19 revolute joints: 15 body joints, 2 wrists and 2 wheels.
  Each arm: shoulder + Arm_Joint1..4 = 5 revolute joints, then a revolute SDK wrist.
  No finger joints, world link, transmissions, controllers, or
  ros2_control/hardware plugins are added.

  Except wheel joint origins/axes copied from Kinematics_only, dimensions,
  joint origins, axes, limits, masses, centers of mass and inertias are
  invented placeholders. Replace them with calibrated
  SolidWorks/measurement data before using this model on hardware.
  Computed gravity, inertia, trajectories and collision results are NOT
  predictions of the real robot.

  SI units: m, kg, s, rad, N.m, kg.m^2.
  Nominal axes: x forward, y left, z up. At q=0 body/hand link frames have aligned
  axes (wheel frames follow the kinematics export); the simple box shapes approximate the drawing's front-view layout.
  Inertial origins locate each box's COM; inertias are about that COM.

  base_link is a fixed reference for FK/TF tests and deliberately has no
  inertial element. All 19 non-root links have positive mass/inertia.
  For floating-base dynamics or physics simulation, separately configure
  a proper base inertia, support/contact model, and controllers.

  A joint origin is expressed in its PARENT link frame and specifies the
  child frame at q=0. Joint axes are expressed in that zero-pose joint frame.
  Visual, collision, and inertial origins are expressed in their OWN link.
-->
  <material name="body_blue">
    <color rgba="0.32 0.52 0.72 1" />
  </material>
  <material name="left_arm_blue">
    <color rgba="0.24 0.57 0.86 1" />
  </material>
  <material name="right_arm_orange">
    <color rgba="0.86 0.48 0.20 1" />
  </material>
  <material name="base_gray">
    <color rgba="0.34 0.37 0.41 1" />
  </material>
  <material name="head_light">
    <color rgba="0.65 0.73 0.81 1" />
  </material>
  <material name="hand_dark">
    <color rgba="0.18 0.23 0.29 1" />
  </material>
  <!-- Fixed root reference. Root geometry only; no root inertia. -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0" />
      <geometry>
        <box size="0.42 0.42 0.12" />
      </geometry>
      <material name="base_gray" />
    </visual>
    <collision>
      <origin xyz="0 0 0.06" rpy="0 0 0" />
      <geometry>
        <box size="0.42 0.42 0.12" />
      </geometry>
    </collision>
  </link>
  <!-- Left wheel: joint frame from Kinematics_only; cylinder, inertia and limits are placeholders.
       Description only: no motor mapping or control interfaces. -->
  <joint name="Left_Wheel_Joint" type="revolute">
    <parent link="base_link" />
    <child link="Left_Wheel_Link" />
    <origin xyz="-0.075 0.30942 -0.063709" rpy="1.5708 0 -3.1416" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14159265359" upper="3.14159265359" effort="1" velocity="1" />
  </joint>
  <link name="Left_Wheel_Link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.5" />
      <inertia ixx="0.00131666666667" ixy="0" ixz="0" iyy="0.00131666666667" iyz="0" izz="0.0025" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><cylinder radius="0.1" length="0.04" /></geometry>
      <material name="base_gray" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><cylinder radius="0.1" length="0.04" /></geometry>
    </collision>
  </link>
  <!-- Right wheel: joint frame from Kinematics_only; cylinder, inertia and limits are placeholders.
       Description only: no motor mapping or control interfaces. -->
  <joint name="Right_Wheel_Joint" type="revolute">
    <parent link="base_link" />
    <child link="Right_Wheel_Link" />
    <origin xyz="-0.075 -0.31058 -0.063709" rpy="1.5708 0 -3.1416" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14159265359" upper="3.14159265359" effort="1" velocity="1" />
  </joint>
  <link name="Right_Wheel_Link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.5" />
      <inertia ixx="0.00131666666667" ixy="0" ixz="0" iyy="0.00131666666667" iyz="0" izz="0.0025" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><cylinder radius="0.1" length="0.04" /></geometry>
      <material name="base_gray" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><cylinder radius="0.1" length="0.04" /></geometry>
    </collision>
  </link>
  <!-- base_link -> Feet_Joint -> Lower_Leg_Link -->
  <joint name="Feet_Joint" type="revolute">
    <parent link="base_link" />
    <child link="Lower_Leg_Link" />
    <origin xyz="0 0 0.12" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-1.57079632679" upper="1.57079632679" effort="20" velocity="1" />
  </joint>
  <link name="Lower_Leg_Link">
    <inertial>
      <origin xyz="0 0 0.15" rpy="0 0 0" />
      <mass value="2" />
      <inertia ixx="0.0166666666667" ixy="0" ixz="0" iyy="0.0166666666667" iyz="0" izz="0.00333333333333" />
    </inertial>
    <visual>
      <origin xyz="0 0 0.15" rpy="0 0 0" />
      <geometry>
        <box size="0.1 0.1 0.3" />
      </geometry>
      <material name="body_blue" />
    </visual>
    <collision>
      <origin xyz="0 0 0.15" rpy="0 0 0" />
      <geometry>
        <box size="0.1 0.1 0.3" />
      </geometry>
    </collision>
  </link>
  <!-- Lower_Leg_Link -> Knee_Joint -> Upper_Leg_Link -->
  <joint name="Knee_Joint" type="revolute">
    <parent link="Lower_Leg_Link" />
    <child link="Upper_Leg_Link" />
    <origin xyz="0 0 0.3" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-1.57079632679" upper="1.57079632679" effort="20" velocity="1" />
  </joint>
  <link name="Upper_Leg_Link">
    <inertial>
      <origin xyz="0 0 0.15" rpy="0 0 0" />
      <mass value="2" />
      <inertia ixx="0.0166666666667" ixy="0" ixz="0" iyy="0.0166666666667" iyz="0" izz="0.00333333333333" />
    </inertial>
    <visual>
      <origin xyz="0 0 0.15" rpy="0 0 0" />
      <geometry>
        <box size="0.1 0.1 0.3" />
      </geometry>
      <material name="body_blue" />
    </visual>
    <collision>
      <origin xyz="0 0 0.15" rpy="0 0 0" />
      <geometry>
        <box size="0.1 0.1 0.3" />
      </geometry>
    </collision>
  </link>
  <!-- Upper_Leg_Link -> Hip_Joint -> Body_Link -->
  <joint name="Hip_Joint" type="revolute">
    <parent link="Upper_Leg_Link" />
    <child link="Body_Link" />
    <origin xyz="0 0 0.3" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-1.57079632679" upper="1.57079632679" effort="20" velocity="1" />
  </joint>
  <link name="Body_Link">
    <inertial>
      <origin xyz="0 0 0.17" rpy="0 0 0" />
      <mass value="5" />
      <inertia ixx="0.0856666666667" ixy="0" ixz="0" iyy="0.0648333333333" iyz="0" izz="0.0541666666667" />
    </inertial>
    <visual>
      <origin xyz="0 0 0.17" rpy="0 0 0" />
      <geometry>
        <box size="0.2 0.3 0.34" />
      </geometry>
      <material name="body_blue" />
    </visual>
    <collision>
      <origin xyz="0 0 0.17" rpy="0 0 0" />
      <geometry>
        <box size="0.2 0.3 0.34" />
      </geometry>
    </collision>
  </link>
  <!-- Body_Link -> Neck_Joint -> Head_Link -->
  <joint name="Neck_Joint" type="revolute">
    <parent link="Body_Link" />
    <child link="Head_Link" />
    <origin xyz="0 0 0.34" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-1.57079632679" upper="1.57079632679" effort="20" velocity="1" />
  </joint>
  <link name="Head_Link">
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0" />
      <mass value="0.6" />
      <inertia ixx="0.00212" ixy="0" ixz="0" iyy="0.001625" iyz="0" izz="0.002745" />
    </inertial>
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0" />
      <geometry>
        <box size="0.15 0.18 0.1" />
      </geometry>
      <material name="head_light" />
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0" />
      <geometry>
        <box size="0.15 0.18 0.1" />
      </geometry>
    </collision>
  </link>
  <!-- Head_Link -> Face_Joint -> Face_Link -->
  <joint name="Face_Joint" type="revolute">
    <parent link="Head_Link" />
    <child link="Face_Link" />
    <origin xyz="0 0 0.1" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-1.57079632679" upper="1.57079632679" effort="20" velocity="1" />
  </joint>
  <link name="Face_Link">
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0" />
      <mass value="0.2" />
      <inertia ixx="0.000706666666667" ixy="0" ixz="0" iyy="0.000226666666667" iyz="0" izz="0.0006" />
    </inertial>
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0" />
      <geometry>
        <box size="0.06 0.18 0.1" />
      </geometry>
      <material name="head_light" />
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0" />
      <geometry>
        <box size="0.06 0.18 0.1" />
      </geometry>
    </collision>
  </link>
  <!-- LEFT ARM: five body revolute joints, followed by a revolute SDK wrist. -->
  <!-- Body_Link -> Left_Shoulder_Joint -> Left_Arm_Link1 -->
  <joint name="Left_Shoulder_Joint" type="revolute">
    <parent link="Body_Link" />
    <child link="Left_Arm_Link1" />
    <origin xyz="0 0.15 0.29" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="-1.57079632679" upper="1.57079632679" effort="20" velocity="1" />
  </joint>
  <link name="Left_Arm_Link1">
    <inertial>
      <origin xyz="0 0.11 0" rpy="0 0 0" />
      <mass value="0.5" />
      <inertia ixx="0.00216666666667" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.00216666666667" />
    </inertial>
    <visual>
      <origin xyz="0 0.11 0" rpy="0 0 0" />
      <geometry>
        <box size="0.06 0.22 0.06" />
      </geometry>
      <material name="left_arm_blue" />
    </visual>
    <collision>
      <origin xyz="0 0.11 0" rpy="0 0 0" />
      <geometry>
        <box size="0.06 0.22 0.06" />
      </geometry>
    </collision>
  </link>
  <!-- Left_Arm_Link1 -> Left_Arm_Joint1 -> Left_Arm_Link2 -->
  <joint name="Left_Arm_Joint1" type="revolute">
    <parent link="Left_Arm_Link1" />
    <child link="Left_Arm_Link2" />
    <origin xyz="0 0.22 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-1.57079632679" upper="1.57079632679" effort="20" velocity="1" />
  </joint>
  <link name="Left_Arm_Link2">
    <inertial>
      <origin xyz="0 0 -0.1" rpy="0 0 0" />
      <mass value="0.8" />
      <inertia ixx="0.00290666666667" ixy="0" ixz="0" iyy="0.00290666666667" iyz="0" izz="0.00048" />
    </inertial>
    <visual>
      <origin xyz="0 0 -0.1" rpy="0 0 0" />
      <geometry>
        <box size="0.06 0.06 0.2" />
      </geometry>
      <material name="left_arm_blue" />
    </visual>
    <collision>
      <origin xyz="0 0 -0.1" rpy="0 0 0" />
      <geometry>
        <box size="0.06 0.06 0.2" />
      </geometry>
    </collision>
  </link>
  <!-- Left_Arm_Link2 -> Left_Arm_Joint2 -> Left_Arm_Link3 -->
  <joint name="Left_Arm_Joint2" type="revolute">
    <parent link="Left_Arm_Link2" />
    <child link="Left_Arm_Link3" />
    <origin xyz="0 0 -0.2" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-1.57079632679" upper="1.57079632679" effort="20" velocity="1" />
  </joint>
  <link name="Left_Arm_Link3">
    <inertial>
      <origin xyz="0 0 -0.1" rpy="0 0 0" />
      <mass value="0.7" />
      <inertia ixx="0.00254333333333" ixy="0" ixz="0" iyy="0.00254333333333" iyz="0" izz="0.00042" />
    </inertial>
    <visual>
      <origin xyz="0 0 -0.1" rpy="0 0 0" />
      <geometry>
        <box size="0.06 0.06 0.2" />
      </geometry>
      <material name="left_arm_blue" />
    </visual>
    <collision>
      <origin xyz="0 0 -0.1" rpy="0 0 0" />
      <geometry>
        <box size="0.06 0.06 0.2" />
      </geometry>
    </collision>
  </link>
  <!-- Left_Arm_Joint3: the unlabeled circle in the provided drawing. -->
  <!-- Left_Arm_Link3 -> Left_Arm_Joint3 -> Left_Arm_Link4 -->
  <joint name="Left_Arm_Joint3" type="revolute">
    <parent link="Left_Arm_Link3" />
    <child link="Left_Arm_Link4" />
    <origin xyz="0 0 -0.2" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-1.57079632679" upper="1.57079632679" effort="20" velocity="1" />
  </joint>
  <link name="Left_Arm_Link4">
    <inertial>
      <origin xyz="0 0 -0.09" rpy="0 0 0" />
      <mass value="0.5" />
      <inertia ixx="0.00145416666667" ixy="0" ixz="0" iyy="0.00145416666667" iyz="0" izz="0.000208333333333" />
    </inertial>
    <visual>
      <origin xyz="0 0 -0.09" rpy="0 0 0" />
      <geometry>
        <box size="0.05 0.05 0.18" />
      </geometry>
