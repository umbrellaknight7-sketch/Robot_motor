<?xml version="1.0"?>
<package format="3">
  <name>wheel_human_commander</name><version>0.1.0</version>
  <description>Whole-robot command ownership and discrete motion coordinator</description>
  <maintainer email="xurui@todo.todo">xurui</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>wheel_human_interfaces</depend>
  <depend>control_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>erob_driver</depend>
  <depend>pinocchio</depend>
  <depend>eigen</depend>
  <depend>urdfdom</depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>wheel_human_description</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
